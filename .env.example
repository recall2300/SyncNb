# ── Strava API ─────────────────────────────────────────────────────────────────
# 앱 등록: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=여기에_클라이언트_ID_입력
STRAVA_CLIENT_SECRET=여기에_클라이언트_시크릿_입력

# 외부 배포 시 실제 도메인으로 변경 (Strava 앱 설정의 Callback Domain과 일치해야 함)
# 로컬 개발: http://localhost:5000/strava/callback
# 외부 배포: https://yourdomain.com/strava/callback
STRAVA_REDIRECT_URI=http://localhost:5000/strava/callback

# ── Flask ───────────────────────────────────────────────────────────────────────
# 반드시 랜덤한 긴 문자열로 변경: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=여기에_랜덤_문자열_입력

# ── 관리자 계정 ─────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=여기에_강한_비밀번호_입력

# ── 보안 설정 ───────────────────────────────────────────────────────────────────
# HTTPS 배포 시 true로 설정 (세션 쿠키 Secure 플래그 활성화)
# 로컬 개발에서는 반드시 false 유지 (true로 하면 로그인 불가)
HTTPS_ENABLED=false

# 공개 인터넷 배포 시 false 권장 (관리자가 직접 계정 생성)
# 혼자 또는 소수만 쓴다면 false로 설정 후 관리자 패널에서 계정 생성
ALLOW_REGISTRATION=true

# ── Docker 이미지 ────────────────────────────────────────────────────────────────
# docker-compose.yml이 참조할 이미지 이름 (Docker Hub에서 pull할 경우 설정)
# 로컬 빌드(build: .) 방식을 쓴다면 이 줄은 무시됨
DOCKER_IMAGE=username/syncnb:latest

# ── 고급 설정 (변경 불필요, 특수 환경에서만) ────────────────────────────────────
# Garmin 토큰 저장 루트 디렉토리 (기본: ~/.garminconnect)
# Docker 배포에서는 named volume이 /home/syncnb/.garminconnect 를 덮어쓰므로 변경 불필요.
# 커스텀 경로가 필요한 경우에만 설정.
# GARMIN_TOKEN_STORE=/custom/path/.garminconnect
